# Copy this file to .env (same folder) and put your real values there.
# .env is git-ignored. NEVER commit a real key.
# On Render, set these in the dashboard: Environment -> Environment Variables.

GROQ_API_KEY=gsk_your_groq_key_goes_here
GROQ_MODEL=openai/gpt-oss-120b

# Websites allowed to call this API (comma-separated)
ALLOWED_ORIGINS=https://lrdlr-demo.web.app,https://lrdlr-demo.firebaseapp.com,http://127.0.0.1:8080,http://localhost:8080
